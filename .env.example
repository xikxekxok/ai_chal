# Скопируйте: cp .env.example .env
# Добавляйте ключи по мере заданий. Не коммитьте .env.

# Harness / general (по необходимости)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# In-app agent API — курс рекомендует дешёвые модели
# DEEPSEEK_API_KEY=

# Dockhost LLM Inference (недели 1–2)
# DOCKHOST_AI_KEY=
# OPENAI_BASE_URL=https://inference.dockhost.io/v1
# DOCKHOST_MODEL=deepseek/deepseek-v3.2

# Ollama (неделя 6 — локальная генерация; Ryzen AI 7 350 + Radeon 860M)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=qwen3:8b
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Другие провайдеры — по заданию
# TELEGRAM_BOT_TOKEN=
